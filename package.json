{
  "name": "polski-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local Polish <-> Russian vocabulary trainer",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.selftest.mjs && node node_modules/.selftest.mjs"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
