# Optional. Only needed for the "generate example sentence" fallback
# (training 4) when a word has no sentences stored in data/vocabulary.json.
# The key is read by the Vite dev server only and is never shipped to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional override. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5
